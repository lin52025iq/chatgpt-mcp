# ===== 本地 HTTP 服务 =====
# 默认仅监听本机回环地址。
HOST=127.0.0.1
PORT=8787

# ===== 公网 MCP 端点与 Cloudflare Tunnel（pnpm start 必填） =====
# ChatGPT 连接的唯一公网地址。服务会直接从此 URL 解析 MCP 路径；建议使用不可猜测的长路径。
# cloudflared 日志级别：debug=调试明细，info=常规状态，warn=警告，error=错误，fatal=致命错误。
# 默认 fatal；启动器不会向终端转发任何级别的 cloudflared 原始输出。
TUNNEL_LOGLEVEL=fatal
CLOUDFLARE_MCP_URL=https://mcp.example.com/mcp/replace-with-a-long-random-secret
TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
